{
  "name": "design-debt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @designdebt/web",
    "dev:api": "npm run dev --workspace @designdebt/api",
    "build": "npm run build --workspaces --if-present",
    "build:vercel-api": "tsc -p tsconfig.vercel.json",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace @designdebt/api",
    "db:migrate": "npm run db:migrate --workspace @designdebt/api",
    "db:deploy": "npm run db:deploy --workspace @designdebt/api"
  },
  "devDependencies": {
    "typescript": "^6.0.0"
  }
}
