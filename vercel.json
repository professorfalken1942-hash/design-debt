{
  "buildCommand": "npm run build --workspaces --if-present",
  "outputDirectory": "apps/web/dist/web/browser",
  "installCommand": "npm install",
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
