{
  "name": "@designdebt/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "prisma generate --schema prisma/schema.prisma",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "test": "node --experimental-strip-types --test src/**/*.test.ts"
  },
  "dependencies": {
    "@designdebt/analysis": "0.1.0",
    "@designdebt/scanner": "0.1.0",
    "@designdebt/shared": "0.1.0",
    "@prisma/client": "6.19.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "nanoid": "^5.1.5",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^20.19.10",
    "prisma": "6.19.3",
    "tsx": "^4.20.4",
    "typescript": "^6.0.0"
  }
}
