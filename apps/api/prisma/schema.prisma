generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scan {
  id          String    @id
  rootUrl     String
  status      String
  createdAt   DateTime  @default(now())
  completedAt DateTime?
  pageCount   Int       @default(0)
  maxPages    Int       @default(20)
  progress    Int       @default(0)
  healthScore Int?
  error       String?
  warnings    Json?
  analysis    Json?
  pages       Page[]
  snapshots   ElementSnapshot[]
  screenshots PageScreenshot[]
  findings    Finding[]
  tokens      TokenProposal[]
  backlog     BacklogItem[]
}

model Page {
  id        String   @id
  scanId    String
  url       String
  createdAt DateTime @default(now())
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model ElementSnapshot {
  id        String   @id
  scanId    String
  pageUrl   String
  tagName   String
  selector  String?
  text      String?
  styles    Json
  width     Int?
  height    Int?
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model PageScreenshot {
  id         String   @id
  scanId     String
  pageUrl    String
  dataUrl    String
  width      Int
  height     Int
  capturedAt DateTime @default(now())
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model Finding {
  id          String @id
  scanId      String
  category    String
  severity    String
  title       String
  description String
  count       Int
  targetView  String
  scan        Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model TokenProposal {
  id         String @id
  scanId     String
  name       String
  value      String
  type       String
  category   String
  uses       Int
  status     String
  confidence String?
  mapsTo     String?
  scan       Scan   @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model BacklogItem {
  id         String   @id
  scanId     String
  sourceType String
  sourceId   String
  title      String
  category   String
  priority   String
  status     String   @default("open")
  owner      String   @default("")
  notes      String   @default("")
  route      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  scan       Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@unique([scanId, sourceType, sourceId])
  @@index([scanId])
}

model WorkspaceSettings {
  id                  String   @id @default("default")
  teamName            String   @default("UIpen Team")
  defaultPageLimit    Int      @default(20)
  crawlerMode         String   @default("same-origin")
  namingPreset        String   @default("scale")
  reviewThreshold     String   @default("balanced")
  ignoredPaths        Json?
  teamNotes           String   @default("")
  screenshotEvidence  Boolean  @default(true)
  reportFormatDefault String   @default("html")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model PageGroup {
  id        String   @id
  name      String
  matchers  Json
  color     String   @default("#4cbaf7")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScanSchedule {
  id        String    @id
  rootUrl   String
  cadence   String
  maxPages  Int       @default(20)
  enabled   Boolean   @default(true)
  nextRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model TeamMember {
  id        String   @id
  name      String
  email     String
  role      String   @default("viewer")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
